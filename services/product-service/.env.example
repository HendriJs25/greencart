APP_ENV=development
APP_PORT=8002
APP_IS_DEBUG_MODE=true

DATABASE_HOST=product-service-db
DATABASE_PORT=5432
DATABASE_NAME=product_service_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_SSL_MODE=disable
DATABASE_MAX_OPEN_CONNECTION=10
DATABASE_MAX_LIFETIME_CONNECTION=10
DATABASE_MAX_IDLE_CONNECTION=10
DATABASE_MAX_IDLE_TIME=10

JWT_SECRET_KEY=
JWT_ISSUER=user-service

REDIS_URL=redis://greencart-redis:6379/0

KAFKA_BROKERS=kafka:19092

AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=aws_user
AWS_SECRET_ACCESS_KEY=aws_password
AWS_S3_BUCKET=greencart-uploads
AWS_S3_ENDPOINT=http://s3:9000
AWS_S3_PUBLIC_BASE_URL=http://localhost:9273/greencart-uploads